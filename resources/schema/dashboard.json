{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Flatpack dashboard composition",
    "description": "Contract for `dashboard.yaml` (JSON-decoded). Defines dashboard widgets and optional tab layout metadata.",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Display name for the dashboard composition."
        },
        "widgets": {
            "type": "object",
            "minProperties": 1,
            "description": "Root widget map keyed by widget id.",
            "additionalProperties": {
                "$ref": "#/$defs/widgetDefinition"
            }
        },
        "tabs": {
            "type": "object",
            "minProperties": 1,
            "description": "Optional dashboard tabs keyed by tab id.",
            "additionalProperties": {
                "$ref": "#/$defs/dashboardTab"
            }
        }
    },
    "oneOf": [
        {
            "required": [
                "widgets"
            ]
        },
        {
            "required": [
                "tabs"
            ]
        }
    ],
    "additionalProperties": false,
    "$defs": {
        "dashboardTab": {
            "type": "object",
            "properties": {
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "icon": {
                    "type": "string",
                    "minLength": 1
                },
                "widgets": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/widgetDefinition"
                    }
                }
            },
            "required": [
                "label",
                "widgets"
            ],
            "additionalProperties": false
        },
        "widgetDefinition": {
            "description": "Discriminated widget union keyed by `type`.",
            "oneOf": [
                {
                    "$ref": "#/$defs/metricWidget"
                },
                {
                    "$ref": "#/$defs/cardWidget"
                }
            ]
        },
        "metricWidget": {
            "type": "object",
            "required": [
                "type",
                "provider",
                "label",
                "value_format",
                "period"
            ],
            "properties": {
                "type": {
                    "const": "metric"
                },
                "provider": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Key in config `flatpack.widget_providers` used to resolve runtime data."
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "value_format": {
                    "$ref": "#/$defs/metricValueFormat"
                },
                "period": {
                    "$ref": "#/$defs/metricPeriod"
                },
                "trend": {
                    "$ref": "#/$defs/metricTrendOptions"
                }
            },
            "additionalProperties": false
        },
        "cardWidget": {
            "type": "object",
            "required": [
                "type",
                "provider",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "card"
                },
                "provider": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "data": {
                    "$ref": "#/$defs/cardWidgetData"
                }
            },
            "additionalProperties": false
        },
        "cardWidgetData": {
            "type": "object",
            "properties": {
                "status": {
                    "$ref": "#/$defs/widgetStatus"
                },
                "value": {
                    "oneOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "context": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "widgetStatus": {
            "type": "string",
            "enum": [
                "default",
                "error",
                "info",
                "success",
                "warning"
            ],
            "description": "Card widget status token used by status badges."
        },
        "metricValueFormat": {
            "type": "object",
            "required": [
                "kind"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "number",
                        "currency",
                        "percentage"
                    ]
                },
                "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                },
                "minimumFractionDigits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                },
                "maximumFractionDigits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                }
            },
            "additionalProperties": false
        },
        "metricPeriod": {
            "type": "object",
            "required": [
                "kind"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "day",
                        "week",
                        "month",
                        "quarter",
                        "year",
                        "custom"
                    ]
                },
                "lookback": {
                    "type": "integer",
                    "minimum": 1
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "metricTrendOptions": {
            "type": "object",
            "properties": {
                "precision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                }
            },
            "additionalProperties": false
        }
    }
}
