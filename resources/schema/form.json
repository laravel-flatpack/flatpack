{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Flatpack form composition",
    "description": "Contract for `form.yaml` (JSON-decoded). Defines form layout, action payloads, and field unions used by normalization and UI rendering.",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Display name for the entity."
        },
        "model": {
            "type": "string",
            "description": "Fully qualified Eloquent model class name."
        },
        "icon": {
            "type": "string",
            "description": "Lucide icon name for navigation and headers."
        },
        "fields": {
            "type": "object",
            "description": "Top-level field map. Fields only defined here render above tabs when tabs are present.",
            "additionalProperties": {
                "$ref": "#/$defs/fieldDefinition"
            }
        },
        "tabs": {
            "type": "object",
            "minProperties": 1,
            "description": "Tab panel map keyed by tab id. Tab fields merge with root fields into one values payload.",
            "additionalProperties": {
                "$ref": "#/$defs/formTabPanel"
            }
        },
        "actions": {
            "$ref": "#/$defs/formActionsBlock",
            "description": "Top-level form actions map keyed by action id."
        }
    },
    "additionalProperties": false,
    "$defs": {
        "formActionsBlock": {
            "type": "object",
            "description": "Named form actions map keyed by action id.",
            "additionalProperties": {
                "$ref": "#/$defs/headerActionDefinition"
            }
        },
        "formTabPanel": {
            "type": "object",
            "required": [
                "label",
                "fields"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "icon": {
                    "type": "string"
                },
                "fields": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/fieldDefinition"
                    }
                }
            },
            "additionalProperties": false,
            "description": "Form tab panel definition with label, optional icon, and field map."
        },
        "headerActionDefinition": {
            "type": "object",
            "required": [
                "label"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "action": {
                    "type": "string"
                },
                "href": {
                    "type": "string"
                },
                "icon": {
                    "type": "string"
                },
                "variant": {
                    "$ref": "#/$defs/buttonVariant"
                },
                "success_message": {
                    "type": "string"
                },
                "confirm": {
                    "type": "boolean"
                },
                "success_redirect": {
                    "$ref": "#/$defs/successRedirect"
                },
                "enabled_if": {
                    "$ref": "#/$defs/actionInactiveUntil"
                },
                "visible_if": {
                    "$ref": "#/$defs/actionInactiveUntil"
                },
                "primary": {
                    "type": "boolean",
                    "description": "When true, this action is the default for implicit form submit (Enter / primary CTA). If multiple are primary, the first in YAML order wins."
                },
                "submit": {
                    "type": "boolean",
                    "description": "When true, clicking this action submits current form values to the form submit endpoint. When false or omitted, it runs as a record action without posting form values."
                },
                "shortcut": {
                    "type": "string"
                }
            },
            "oneOf": [
                {
                    "required": [
                        "action"
                    ],
                    "not": {
                        "required": [
                            "href"
                        ]
                    }
                },
                {
                    "required": [
                        "href"
                    ],
                    "not": {
                        "required": [
                            "action"
                        ]
                    }
                }
            ],
            "additionalProperties": false,
            "description": "Header action definition for form pages. Requires exactly one of `action` or `href`."
        },
        "buttonVariant": {
            "type": "string",
            "enum": [
                "default",
                "outline",
                "secondary",
                "ghost",
                "destructive",
                "link",
                "primary"
            ],
            "description": "Supported button style variants. `primary` is accepted and normalized to `default` in UI code."
        },
        "successRedirect": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "list",
                        "edit",
                        "create",
                        "show",
                        "back",
                        "previous",
                        "current",
                        "stay"
                    ]
                },
                {
                    "type": "boolean",
                    "enum": [
                        true
                    ],
                    "description": "Alias for list (redirect to entity index after success)."
                }
            ],
            "description": "Post-action redirect target keyword, or `true` as alias for `list`."
        },
        "actionInactiveUntil": {
            "type": "object",
            "description": "Action gating definition that disables actions until predicates pass.",
            "properties": {
                "all": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/actionInactivePredicate"
                    }
                },
                "any": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/actionInactivePredicate"
                    }
                },
                "message": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "anyOf": [
                {
                    "required": [
                        "all"
                    ]
                },
                {
                    "required": [
                        "any"
                    ]
                }
            ],
            "additionalProperties": false
        },
        "actionInactivePredicate": {
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "form.dirty"
                    ],
                    "properties": {
                        "form.dirty": {
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "form.mode_in"
                    ],
                    "properties": {
                        "form.mode_in": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "create",
                                    "edit"
                                ]
                            }
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "list.selection.min"
                    ],
                    "properties": {
                        "list.selection.min": {
                            "type": "integer",
                            "minimum": 0
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "list.search_present"
                    ],
                    "properties": {
                        "list.search_present": {
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "list.filters_applied"
                    ],
                    "properties": {
                        "list.filters_applied": {
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                }
            ],
            "description": "Single predicate used by `enabled_if` or `visible_if` gating rules."
        },
        "yamlFormFieldType": {
            "type": "string",
            "description": "Raw YAML field types before normalization. `date` is normalized to `date-picker`.",
            "enum": [
                "text",
                "textarea",
                "select",
                "combobox",
                "date",
                "date-picker",
                "date-range-picker",
                "time-picker",
                "checkbox",
                "switch",
                "rich-text",
                "block-editor",
                "table",
                "widget"
            ]
        },
        "selectOption": {
            "type": "object",
            "required": [
                "value",
                "label"
            ],
            "properties": {
                "value": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "$ref": "#/$defs/optionStatus"
                },
                "icon": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "description": "Select option object with value, label, and optional status or icon."
        },
        "optionStatus": {
            "type": "string",
            "enum": [
                "success",
                "pending",
                "warning",
                "error",
                "info"
            ],
            "description": "Status token used by option badges and chips."
        },
        "selectOptions": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/selectOption"
                    }
                },
                {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            ],
            "description": "Select options as an array of option objects or keyed map form."
        },
        "validationRules": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ],
            "description": "Laravel validation rules as a pipe-delimited string or string array."
        },
        "preset": {
            "type": "object",
            "required": [
                "field",
                "type"
            ],
            "properties": {
                "field": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Source field id to copy from"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "exact",
                        "slug",
                        "url",
                        "camel",
                        "file"
                    ]
                }
            },
            "additionalProperties": false,
            "description": "Preset source definition for copying values from another field."
        },
        "fieldTriggerCondition": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "checked",
                        "unchecked"
                    ]
                },
                {
                    "type": "string",
                    "pattern": "^value\\[[^\\]]+\\]$"
                }
            ],
            "description": "Condition expression used by dynamic field trigger rules."
        },
        "fieldTrigger": {
            "type": "object",
            "required": [
                "action",
                "field",
                "condition"
            ],
            "properties": {
                "action": {
                    "type": "string",
                    "enum": [
                        "show",
                        "hide",
                        "enable",
                        "disable",
                        "empty"
                    ]
                },
                "field": {
                    "type": "string",
                    "minLength": 1
                },
                "condition": {
                    "$ref": "#/$defs/fieldTriggerCondition"
                }
            },
            "additionalProperties": false,
            "description": "Trigger rule definition for conditional field behavior."
        },
        "fieldDefinition": {
            "description": "Discriminated field union keyed by `type`.",
            "oneOf": [
                {
                    "$ref": "#/$defs/fieldText"
                },
                {
                    "$ref": "#/$defs/fieldTextarea"
                },
                {
                    "$ref": "#/$defs/fieldSelect"
                },
                {
                    "$ref": "#/$defs/fieldCombobox"
                },
                {
                    "$ref": "#/$defs/fieldDate"
                },
                {
                    "$ref": "#/$defs/fieldDatePicker"
                },
                {
                    "$ref": "#/$defs/fieldDateRangePicker"
                },
                {
                    "$ref": "#/$defs/fieldTimePicker"
                },
                {
                    "$ref": "#/$defs/fieldCheckbox"
                },
                {
                    "$ref": "#/$defs/fieldSwitch"
                },
                {
                    "$ref": "#/$defs/fieldRichText"
                },
                {
                    "$ref": "#/$defs/fieldBlockEditor"
                },
                {
                    "$ref": "#/$defs/fieldTable"
                },
                {
                    "$ref": "#/$defs/fieldWidget"
                }
            ]
        },
        "fieldText": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "text"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "preset": {
                    "$ref": "#/$defs/preset"
                },
                "format": {
                    "type": "string",
                    "enum": [
                        "slug",
                        "url",
                        "camel",
                        "file"
                    ]
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Text input field definition."
        },
        "fieldTextarea": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "textarea"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "rows": {
                    "type": "integer",
                    "minimum": 1
                },
                "preset": {
                    "$ref": "#/$defs/preset"
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Textarea field definition."
        },
        "fieldSelect": {
            "type": "object",
            "required": [
                "type",
                "label",
                "options"
            ],
            "properties": {
                "type": {
                    "const": "select"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "options": {
                    "$ref": "#/$defs/selectOptions"
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Select field definition with static or relation-backed options."
        },
        "fieldCombobox": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "combobox"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "options": {
                    "$ref": "#/$defs/selectOptions"
                },
                "multiple": {
                    "type": "boolean"
                },
                "relation": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Eloquent relation method for remote options; use type combobox + relation instead of obsolete type relation."
                },
                "relation_name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Label column on related model for relation-options / chips"
                },
                "relation_value": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Value column on related model (often id)"
                },
                "remote": {
                    "type": "boolean"
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Combobox field definition with optional relation-backed options."
        },
        "fieldDate": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "date"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Legacy date field alias definition."
        },
        "fieldDatePicker": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "date-picker"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Date picker field definition."
        },
        "fieldDateRangePicker": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "date-range-picker"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Date range picker field definition."
        },
        "fieldTimePicker": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "time-picker"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "dateLabel": {
                    "type": "string"
                },
                "datePlaceholder": {
                    "type": "string"
                },
                "timeLabel": {
                    "type": "string"
                },
                "timeDefaultValue": {
                    "type": "string"
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Time picker field definition."
        },
        "fieldCheckbox": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "checkbox"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "defaultChecked": {
                    "type": "boolean"
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Checkbox field definition."
        },
        "fieldSwitch": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "switch"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "defaultChecked": {
                    "type": "boolean"
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Switch field definition."
        },
        "fieldRichText": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "rich-text"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "showFixedToolbar": {
                    "type": "boolean"
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Rich text editor field definition."
        },
        "fieldBlockEditor": {
            "type": "object",
            "required": [
                "type",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "block-editor"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "placeholder": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "showFixedToolbar": {
                    "type": "boolean"
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Block editor field definition."
        },
        "fieldTableActionEntry": {
            "type": "object",
            "description": "Embedded table toolbar action definition.",
            "required": [
                "label",
                "action"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "action": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Built-in: `create` and `add` open a blank draft row in the row detail drawer (same UX path). Other values are custom and use host onToolbarAction when wired."
                },
                "icon": {
                    "type": "string"
                },
                "variant": {
                    "type": "string",
                    "enum": [
                        "default",
                        "destructive",
                        "outline",
                        "secondary",
                        "ghost",
                        "link",
                        "primary"
                    ]
                }
            },
            "additionalProperties": false
        },
        "fieldWidget": {
            "type": "object",
            "required": [
                "type",
                "label",
                "widget"
            ],
            "properties": {
                "type": {
                    "const": "widget"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "widget": {
                    "type": "object",
                    "minProperties": 1,
                    "description": "Single-widget map keyed by widget id and resolved by widget runtime.",
                    "additionalProperties": {
                        "$ref": "#/$defs/widgetDefinition"
                    }
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false,
            "description": "Read-only widget field definition rendered inside forms."
        },
        "fieldTableActions": {
            "description": "Embedded table toolbar actions as keyed map or ordered array.",
            "oneOf": [
                {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/fieldTableActionEntry"
                    }
                },
                {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/fieldTableActionEntry"
                    }
                }
            ]
        },
        "fieldTable": {
            "type": "object",
            "required": [
                "type",
                "label",
                "columns"
            ],
            "description": "Embedded table field definition with columns, row behavior, and optional relation hydration.",
            "properties": {
                "type": {
                    "const": "table"
                },
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "helperText": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "value": {},
                "columns": {
                    "description": "Same shapes as list.yaml columns: array of column definitions, or map of columnId -> definition. Embedded table columns may set `edit_form_field` (full form-field shape) to override row-drawer rendering.",
                    "oneOf": [
                        {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "$ref": "#/$defs/embeddedTableColumnDefinition"
                            }
                        },
                        {
                            "type": "object",
                            "minProperties": 1,
                            "additionalProperties": {
                                "$ref": "#/$defs/embeddedTableColumnDefinition"
                            }
                        }
                    ]
                },
                "data": {
                    "type": "array"
                },
                "bulkActions": {
                    "type": "array"
                },
                "actions": {
                    "$ref": "#/$defs/fieldTableActions",
                    "description": "Toolbar buttons. If both `actions` and `toolbar` are set, `actions` is used."
                },
                "toolbar": {
                    "$ref": "#/$defs/fieldTableActions",
                    "description": "Alias for `actions` (same shape). Ignored when `actions` is present."
                },
                "toolbar_actions": {
                    "$ref": "#/$defs/fieldTableActions",
                    "description": "Legacy list-style key; same shape as `actions`. Used only when `actions` and `toolbar` are absent."
                },
                "toolbarActions": {
                    "$ref": "#/$defs/fieldTableActions",
                    "description": "Legacy camelCase key; same shape as `actions`. Lowest precedence among toolbar sources."
                },
                "reorderable": {
                    "oneOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "row_detail_drawer": {
                    "type": "boolean",
                    "description": "When false, clicking a data row does not open the row detail drawer; toolbar `create` still uses the drawer for new rows (`add`/other may share that drawer when wired)."
                },
                "relation": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Eloquent relation method name on the parent model; when present, table is relation-backed (hydration + sync)."
                },
                "relation_value": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Related model key attribute for RelationRow identity (default id)."
                },
                "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Max related rows to hydrate (capped also by config flatpack.forms)."
                },
                "table_relation_type": {
                    "type": "string",
                    "enum": [
                        "belongs_to_many",
                        "has_many",
                        "morph_many",
                        "morph_to_many",
                        "has_one",
                        "unknown"
                    ],
                    "description": "Eloquent relation class for this table field, usually derived from the parent form model. Authors may set this in YAML to override auto-detection."
                },
                "trigger": {
                    "$ref": "#/$defs/fieldTrigger"
                }
            },
            "additionalProperties": false
        },
        "embeddedTableColumnEditFormFieldDefinition": {
            "type": "object",
            "required": [
                "type"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "text",
                        "textarea",
                        "select",
                        "combobox",
                        "date-picker",
                        "date-range-picker",
                        "time-picker",
                        "checkbox",
                        "switch",
                        "rich-text",
                        "block-editor",
                        "table"
                    ]
                }
            },
            "additionalProperties": false,
            "description": "Inline row-drawer edit field override for embedded table columns."
        },
        "embeddedTableColumnDefinition": {
            "type": "object",
            "required": [
                "label"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "text",
                        "select",
                        "date",
                        "datetime",
                        "actions",
                        "badge",
                        "status",
                        "relation"
                    ]
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "options": {
                    "$ref": "#/$defs/selectOptions"
                },
                "actions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/fieldTableActionEntry"
                    }
                },
                "relation": {
                    "type": "string",
                    "minLength": 1
                },
                "relation_name": {
                    "type": "string",
                    "minLength": 1
                },
                "relation_value": {
                    "type": "string",
                    "minLength": 1
                },
                "relationName": {
                    "type": "string",
                    "minLength": 1
                },
                "relationValue": {
                    "type": "string",
                    "minLength": 1
                },
                "format": {
                    "type": "string"
                },
                "timezone": {
                    "type": "string"
                },
                "sortable": {
                    "type": "boolean"
                },
                "searchable": {
                    "type": "boolean"
                },
                "editable": {
                    "type": "boolean"
                },
                "required": {
                    "type": "boolean"
                },
                "rules": {
                    "$ref": "#/$defs/validationRules"
                },
                "detailDrawer": {
                    "type": "boolean"
                },
                "invisible": {
                    "type": "boolean"
                },
                "truncate": {
                    "type": "integer",
                    "minimum": 1
                },
                "edit_form_field": {
                    "$ref": "#/$defs/embeddedTableColumnEditFormFieldDefinition"
                },
                "editFormField": {
                    "$ref": "#/$defs/embeddedTableColumnEditFormFieldDefinition"
                }
            },
            "additionalProperties": false,
            "description": "Embedded table column definition with optional edit field override."
        },
        "widgetDefinition": {
            "description": "Discriminated widget union keyed by `type`.",
            "oneOf": [
                {
                    "$ref": "#/$defs/metricWidget"
                },
                {
                    "$ref": "#/$defs/cardWidget"
                }
            ]
        },
        "metricWidget": {
            "type": "object",
            "required": [
                "type",
                "provider",
                "label",
                "value_format",
                "period"
            ],
            "properties": {
                "type": {
                    "const": "metric"
                },
                "provider": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Key in config `flatpack.widget_providers` used to resolve runtime data."
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "value_format": {
                    "$ref": "#/$defs/metricValueFormat"
                },
                "period": {
                    "$ref": "#/$defs/metricPeriod"
                },
                "trend": {
                    "$ref": "#/$defs/metricTrendOptions"
                }
            },
            "additionalProperties": false
        },
        "cardWidget": {
            "type": "object",
            "required": [
                "type",
                "provider",
                "label"
            ],
            "properties": {
                "type": {
                    "const": "card"
                },
                "provider": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "data": {
                    "$ref": "#/$defs/cardWidgetData"
                }
            },
            "additionalProperties": false
        },
        "cardWidgetData": {
            "type": "object",
            "properties": {
                "status": {
                    "$ref": "#/$defs/widgetStatus"
                },
                "value": {
                    "oneOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "context": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "widgetStatus": {
            "type": "string",
            "enum": [
                "default",
                "error",
                "info",
                "success",
                "warning"
            ],
            "description": "Card widget status token used by status badges."
        },
        "metricValueFormat": {
            "type": "object",
            "required": [
                "kind"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "number",
                        "currency",
                        "percentage"
                    ]
                },
                "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                },
                "minimumFractionDigits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                },
                "maximumFractionDigits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                }
            },
            "additionalProperties": false
        },
        "metricPeriod": {
            "type": "object",
            "required": [
                "kind"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "day",
                        "week",
                        "month",
                        "quarter",
                        "year",
                        "custom"
                    ]
                },
                "lookback": {
                    "type": "integer",
                    "minimum": 1
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "metricTrendOptions": {
            "type": "object",
            "properties": {
                "precision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                }
            },
            "additionalProperties": false
        }
    }
}
