# Flatpack Vite — copy to .env and adjust (host Laravel .env is not used).

VITE_APP_NAME=Flatpack

# Dev server (npm run dev)
VITE_HOST=127.0.0.1
VITE_PORT=5174

# Where Vite writes `build/` + `hot` for the host app (directory that will contain build/ and hot).
# Default if unset: ./public in this package (assets in public/build).
# For local dev against a host app, use a path to that app’s published tree, e.g.:
# FLATPACK_PUBLIC_DEST=../your-app/public/vendor/flatpack
# (not .../vendor/flatpack/build — that folder is created by Vite.)
# FLATPACK_PUBLIC_DEST=
