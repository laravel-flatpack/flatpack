# Flatpack Vite — copy to .env and adjust (host Laravel .env is not used).

VITE_APP_NAME=Laravel

# Dev server (npm run dev)
VITE_HOST=127.0.0.1
VITE_PORT=5174

# Where `npm run build` writes manifest + assets for the Laravel public/ tree.
# Default if unset: /public/flatpack (relative to this package directory).
# Use an absolute path when the package lives somewhere other than beside the app.
# FLATPACK_PUBLIC_DEST=
