{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "clean": "node ./scripts/clean-build.mjs",
        "build": "vite build",
        "build:analyze": "FLATPACK_BUNDLE_ANALYZE=1 vite build",
        "watch": "vite build --watch",
        "lint": "biome check resources/js resources/css",
        "lint:fix": "biome check --write resources/js resources/css",
        "format": "biome format --write resources/js resources/css",
        "types:check": "tsc --project tsconfig.app.json --noEmit",
        "types:check:tools": "tsc --project tsconfig.tools.json --noEmit",
        "types:check:all": "npm run types:check && npm run types:check:tools",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:coverage:watch": "vitest --coverage",
        "test:watch": "vitest",
        "test:backend": "composer run test",
        "check": "npm run format && npm run lint:fix && npm run types:check:all && npm run test",
        "check:all": "composer run schema:keys && composer run check && npm run check"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.10",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/lodash": "^4.17.24",
        "@types/node": "^22.13.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.5",
        "jsdom": "^29.0.2",
        "rollup-plugin-visualizer": "^7.0.1",
        "typescript": "^5.7.2",
        "vitest": "^4.1.4"
    },
    "dependencies": {
