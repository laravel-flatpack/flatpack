{
    "name": "flatpack/flatpack",
    "description": "Flatpack: Administration panel for Laravel, ready to assemble.",
    "keywords": [
        "flatpack",
        "laravel",
        "administration",
        "admin",
        "panel"
    ],
    "homepage": "https://github.com/laravel-flatpack/flatpack",
    "license": "MIT",
    "authors": [
        {
            "name": "Fausto Quaggia",
            "email": "hello@faustoquaggia.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/framework": "^13.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Flatpack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flatpack\\Tests\\": "tests/",
            "Flatpack\\Tests\\Database\\Factories\\": "tests/database/Factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Flatpack\\FlatpackServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint",
        "lint:test": "pint --test",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "rector": "rector --dry-run",
        "test": "pest",
        "check": "composer run lint && composer run rector && composer run phpstan && composer run test"
    }
}
