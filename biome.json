{
    "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "on",
                    "options": {
                        "groups": [
                            ":URL:",
                            ":BUN:",
                            ":NODE:",
                            ":PACKAGE_WITH_PROTOCOL:",
                            ":PACKAGE:",
                            ":ALIAS:",
                            ":PATH:"
                        ]
                    }
                }
            }
        }
    },
    "files": {
        "includes": [
            "resources/js/**",
            "resources/css/**"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "a11y": {
                "noPositiveTabindex": "off",
                "noSvgWithoutTitle": "off",
                "useSemanticElements": "off"
            },
            "style": {
                "useSelfClosingElements": "off"
            },
            "suspicious": {
                "noDocumentCookie": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["resources/js/components/ui/**/*.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noStaticElementInteractions": "off",
                        "useFocusableInteractive": "off",
                        "useKeyWithClickEvents": "off",
                        "useMediaCaption": "off"
                    },
                    "correctness": {
                        "useExhaustiveDependencies": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off"
                    },
                    "suspicious": {
                        "noArrayIndexKey": "off",
                        "noExplicitAny": "off",
                        "noNonNullAssertedOptionalChain": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        },
        "formatter": {
            "indentStyle": "space",
            "indentWidth": 4,
            "quoteStyle": "single"
        }
    }
}
